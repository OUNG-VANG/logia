PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/logia
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

# Adresse publique du site (liens envoyés par e-mail) et origines autorisées à appeler l'API (séparées par des virgules).
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Derrière un hébergeur qui fait office de proxy, mets 1 pour que les limites voient la vraie adresse IP.
# TRUST_PROXY=1
# Uniquement pour un serveur de test (script de démonstration) : désactive les limites de requêtes.
# RATE_LIMITS=off

# Envoi des e-mails (mot de passe oublié). Sans SMTP_HOST, le message s'affiche dans la console du serveur.
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Logia <no-reply@exemple.fr>
